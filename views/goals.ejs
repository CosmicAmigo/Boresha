<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Boresha Goals</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <%- include('partials/nav', { user: user, activePage: activePage }) %>
  <main>
    <section class="section">
      <div class="section-header">
        <div>
          <h2>Goals</h2>
          <p>Create savings goals and track your progress.</p>
        </div>
      </div>
      <div class="grid grid-2">
        <div class="card form-card">
          <h3>Add new goal</h3>
          <form action="/goals" method="post">
            <div class="form-field">
              <label for="name">Goal name</label>
              <input id="name" name="name" required placeholder="Emergency fund, college tuition" />
            </div>
            <div class="form-field">
              <label for="target">Target amount</label>
              <input id="target" name="target" type="number" min="0" step="0.01" required placeholder="0.00" />
            </div>
            <div class="form-field">
              <label for="saved">Already saved</label>
              <input id="saved" name="saved" type="number" min="0" step="0.01" placeholder="0.00" />
            </div>
            <div class="form-field">
              <label for="due">Due date</label>
              <input id="due" name="due" type="date" required />
            </div>
            <button class="button" type="submit">Create goal</button>
          </form>
        </div>
        <div class="card">
          <h3>Current goals</h3>
          <table class="table">
            <thead>
              <tr><th>Name</th><th>Target</th><th>Saved</th><th>Due</th><th>Progress</th></tr>
            </thead>
            <tbody>
              <% if (!goals.length) { %>
                <tr><td colspan="5" class="label">No goals defined yet.</td></tr>
              <% } %>
              <% goals.forEach(goal => { %>
                <tr>
                  <td><%= goal.name %></td>
                  <td><%= settings.currency %> <%= Number(goal.target).toFixed(2) %></td>
                  <td><%= settings.currency %> <%= Number(goal.saved).toFixed(2) %></td>
                  <td><%= new Date(goal.due).toISOString().slice(0,10) %></td>
                  <td><%= Math.min(100, Math.round((goal.saved / goal.target) * 100)) %>%</td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
