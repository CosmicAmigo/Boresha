# PostgreSQL connection string (provided by Render or your PostgreSQL provider)
DATABASE_URL=postgresql://user:password@localhost:5432/boresha

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match the redirect URI in Google Cloud Console
# For Render: https://your-app.render.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session secret - use a long random string in production
SESSION_SECRET=your-secure-random-secret-key

# Environment (optional, defaults to development)
NODE_ENV=development
PORT=3000

